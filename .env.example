# ============================================
# Base de Datos
# ============================================
POSTGRES_DB=tempdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ============================================
# Spring Boot Datasource
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://temp-db:5432/tempdb
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ============================================
# JWT
# ============================================
# Access token (se envía en cada petición)
APP_JWT_ACCESS_EXPIRATION_MINUTES=15
# Refresh token (se guarda en el cliente y renueva el access; se rota + revoca en BD)
APP_JWT_REFRESH_EXPIRATION_DAYS=7

# Clave HMAC en Base64 (al menos 32 bytes para HS256)
APP_JWT_SECRET=ezkyO/2l7ExQ5LfJYgGT1dVtF1WGAFMAY6vtvomGmxY=

# ============================================
# Compactación de lecturas (rollup + purga)
# ============================================
# Habilita el job de compactación (dom 03:00 UTC por defecto)
COMPACTACION_ENABLED=false
COMPACTACION_CRON=0 0 3 * * SUN
# Días que se conservan las lecturas crudas (el resto se agrega a diario y se purga)
COMPACTACION_RETENCION_DIAS=30
# Meses que se conservan los buckets diarios antes de agregarlos a mensual
COMPACTACION_RETENCION_MESES=12
# Tamaño de lote para purgar el bruto sin saturar la BD
COMPACTACION_MAX_LOTE=100000

# ============================================
# Puerto de la aplicación
# ============================================
SERVER_PORT=8080
